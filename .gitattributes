# Normalise line endings so Windows and Linux contributors produce identical diffs.
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.astro text eol=lf
*.mako text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
.githooks/* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
*.ps1  text eol=crlf

# Binary assets: never diff or merge as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.pdf  binary

# Lockfiles are generated: keep them out of diffs and merges.
package-lock.json -diff merge=binary
