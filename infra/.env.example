# Copy to infra/.env (git-ignored). Real secrets live ONLY in infra/.env and legacy/orchestrator/.env.
POSTGRES_PASSWORD=change-me
JWT_SECRET=long-random-string
OPENWA_WEBHOOK_SECRET=long-random-string
COOKIE_SECURE=false            # true behind HTTPS
ADMIN_EMAIL=admin@connectflow.example.com
ADMIN_PASSWORD=change-me-long

# Web entrypoint (local defaults shown). Production: SCHEME=https, SITE_HOST=example.com, APP_HOST=app.example.com
SCHEME=http
SITE_HOST=connectflow.localhost
APP_HOST=app.connectflow.localhost
APP_PORT=8080

# Gateway
OPENWA_IMAGE=ghcr.io/rmyndharis/openwa:latest   # pin a version for production

# Legacy One Group stack only (docker compose --profile legacy ...)
TZ=Asia/Karachi
SEARXNG_SECRET=change-me-random-string
LEGACY_DASHBOARD_PORT=3100
LEGACY_OPENWA_PORT=2785

# Google sign-in (optional). Create an OAuth client (type: Web application) in Google Cloud Console and add the redirect URI
#   <PUBLIC_APP_URL>/api/auth/google/callback
PUBLIC_APP_URL=http://app.connectflow.localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SITE_URL=http://connectflow.localhost:8080

# Email (Mailpit locally). Production: a real SMTP provider.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ConnectFlow <no-reply@yourdomain.com>
# Webhooks may only target public https URLs. true = also allow private/localhost targets. LOCAL DEVELOPMENT ONLY.
WEBHOOK_ALLOW_PRIVATE=false

# Production email with Resend (https://resend.com): create an API key, verify your domain, then set these.
# SMTP_FROM must use the verified domain, e.g.  ConnectFlow <no-reply@yourdomain.com>
RESEND_API_KEY=

# Platform-admin dashboard (separate host)
ADMIN_HOST=admin.connectflow.localhost
ADMIN_URL=http://admin.connectflow.localhost:8080

# ---- AI + search for the lead-gen engine ----
# DeepSeek (or any OpenAI-compatible provider) key. Keep it secret.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro
SEARXNG_URL=http://searxng:8080     # set automatically by docker-compose for api/worker
# AI cost control (docs/BILLING.md, docs/RUNBOOK.md 'Scaling and operations')
AI_GLOBAL_DAILY_CAP=0                # AI calls per UTC day for the WHOLE platform (circuit breaker). 0 = off, allowed only in development: REQUIRED > 0 when COOKIE_SECURE=true (e.g. 5000)
AI_PRICE_IN_PER_M=0                  # USD per MILLION input tokens for AI_MODEL (copy from your provider's price page; 0 = unknown, the admin cost columns then show n/a)
AI_PRICE_OUT_PER_M=0                 # USD per million output tokens
AI_PRICE_CACHED_PER_M=0              # USD per million cached input tokens (providers with prompt caching, e.g. DeepSeek cache hits)
# optional CHEAPER model for extraction/classification-like calls (website pick, page facts, follow-ups); empty = use AI_MODEL
AI_MODEL_FAST=
AI_KNOWLEDGE_MAX_CHARS=8000          # the knowledge base is sent with EVERY AI call; cap what is injected (the profile can still store 20000 characters)
# Dev/test switches. Leave both false in real use.
AI_FAKE=false                        # true = deterministic fake AI text (no provider calls)
OUTREACH_FAKE_SEND=false             # true = the sender marks messages sent without calling WhatsApp

# ---- Gateway safety / capacity (see docs/RUNBOOK.md "Sizing")
OPENWA_DB_PASSWORD=change-me-random          # password of the `openwa` role created by gateway-db-init
GATEWAY_MAX_SESSIONS=20                      # hard cap enforced by the gateway (MAX_CONCURRENT_SESSIONS)
PLATFORM_MAX_INSTANCES=20                    # API refuses new numbers beyond this (waiting list); keep <= GATEWAY_MAX_SESSIONS
GATEWAY_MEM_LIMIT=4g                         # 4 GB ~ 10-25 sessions; 8g ~ 25-50 (OpenWA's own table)
# ---- Session reaper / reconciler
REAPER_ENABLED=true
REAPER_DRY_RUN=false                         # true = only log what would be deleted
REAP_UNSCANNED_MINUTES=10                    # delete sessions whose QR was never scanned
REAP_TRIAL_IDLE_DAYS=7                       # stop idle TRIAL sessions (0 = off)
# ---- Retention (days / months; messages and leads are never pruned)
RETENTION_ENABLED=true
RETENTION_HOUR_UTC=3
RETENTION_WEBHOOK_DAYS=30
RETENTION_NOTIFICATION_DAYS=90
RETENTION_AUDIT_MONTHS=24
RETENTION_USAGE_MONTHS=13
RETENTION_DRAFT_DAYS=180
RETENTION_BATCH_MONTHS=12
# ---- Observability
# optional; scrubbed (no headers/cookies/bodies)
SENTRY_DSN=
LOG_JSON=true
# ---- Backups (infra/scripts/backup.sh)
BACKUP_PASSPHRASE=change-me-long-random      # encrypts the archived .env (required)
# BACKUP_DIR=../backups   BACKUP_STOP_GATEWAY=1   RCLONE_REMOTE=remote:connectflow   S3_BUCKET=s3://my-bucket/connectflow
# ---- Security (M5)
# REQUIRED in production: encrypts webhook secrets + 2FA secrets. python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# only while rotating the key (docs/SECRETS.md)
ENCRYPTION_KEY_PREVIOUS=
# ADMIN_2FA_REQUIRED=true                   # default: on in production (COOKIE_SECURE=true), off locally; uncomment to force true/false
# comma list of domains allowed even though they are on the disposable-email list
DISPOSABLE_EMAIL_ALLOW=
# optional Cloudflare captcha (signup / forgot password / login after failures): set BOTH keys or neither
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe billing (leave empty to keep the manual upgrade-request flow). See docs/BILLING.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Media library (images, PDFs, short videos, links attached to messages). See docs/MEDIA.md
STORAGE_BACKEND=local                        # local = Docker volume (assets-data) | cloudinary
# only for STORAGE_BACKEND=cloudinary: cloudinary://<api_key>:<api_secret>@<cloud_name>  (a SECRET: put it only in infra/.env)
CLOUDINARY_URL=

# --- All other passwords and keys also live in this file (see docs/CREDENTIALS_MAP.md)
# Old dashboard login password (http://127.0.0.1:3100). Pick a long random one.
DASHBOARD_PASSWORD=change-me-long-random
LEGACY_SESSION_SECRET=change-me-random-64-chars
LEGACY_WEBHOOK_SECRET=change-me-random-64-chars
# Reference copies of the OpenWA admin keys (OpenWA keeps only a hash)
LEGACY_OPENWA_API_KEY=
GATEWAY_OPENWA_API_KEY=
