---
// Decorative QR-style pattern (not a real code). Deterministic so builds are stable.
const N = 25;
let s = 7;
const rnd = () => ((s = (s * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff);
const finder = (x: number, y: number) => (x < 7 && y < 7) || (x >= N - 7 && y < 7) || (x < 7 && y >= N - 7);
const cells: Array<[number, number]> = [];
for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) if (!finder(x, y) && rnd() > 0.52) cells.push([x, y]);
const eyes = [[0, 0], [N - 7, 0], [0, N - 7]];
---
<svg viewBox={`0 0 ${N} ${N}`} shape-rendering="crispEdges" aria-hidden="true">
  {cells.map(([x, y]) => <rect x={x} y={y} width="1" height="1" fill="#0a1410" />)}
  {eyes.map(([x, y]) => (
    <g>
      <rect x={x} y={y} width="7" height="7" fill="#0a1410" />
      <rect x={x + 1} y={y + 1} width="5" height="5" fill="#fff" />
      <rect x={x + 2} y={y + 2} width="3" height="3" fill="#0a1410" />
    </g>
  ))}
</svg>
